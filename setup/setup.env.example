# Copy this file to setup/setup.env and fill it in. setup.env is git-ignored.
# Every phase reads it. Paths may use ~.

# ---------------------------------------------------------------------------
# Products and accelerators
# ---------------------------------------------------------------------------

# Where the products get extracted.
WORK_DIR=~/nonreg-ob

# Give either the zip (it gets extracted into WORK_DIR) or an already extracted home.
APIM_ZIP=~/Downloads/wso2am-4.7.0.zip
APIM_HOME=
IS_ZIP=~/Downloads/wso2is-7.3.0.zip
IS_HOME=

# The WSO2 Financial Services accelerators 4.0.
FSAM_ZIP=~/Downloads/wso2-fsam-accelerator-4.0.0.zip
FSIAM_ZIP=~/Downloads/wso2-fsiam-accelerator-4.0.0.zip

# MySQL JDBC driver, copied into both products.
MYSQL_JDBC_JAR=~/Downloads/mysql-connector-java-5.1.44.jar

# ---------------------------------------------------------------------------
# Java
# ---------------------------------------------------------------------------

# JDK used to run the servers. Leave empty to use the JAVA_HOME of your shell.
SERVER_JAVA_HOME=
# JDK used to build this repo with Maven (Java 8). Leave empty to use the JAVA_HOME of your shell.
BUILD_JAVA_HOME=

# ---------------------------------------------------------------------------
# MySQL
# ---------------------------------------------------------------------------

DB_HOST=localhost
DB_USER=root
DB_PASS=root
# Prefix for the database names. configure.sh DROPS and recreates these databases.
DB_PREFIX=nonreg_ob_

# ---------------------------------------------------------------------------
# Servers
# ---------------------------------------------------------------------------

OB_HOST=localhost

IS_ADMIN_USERNAME=is_admin@wso2.com
IS_ADMIN_PASSWORD=wso2123
AM_ADMIN_USERNAME=am_admin@wso2.com
AM_ADMIN_PASSWORD=wso2123
AM_ADMIN_NAME=am_admin

# Name of the key manager added to API Manager.
KEY_MANAGER_NAME=FSKM

# ---------------------------------------------------------------------------
# Client application and customer
# ---------------------------------------------------------------------------

# The client application's developer, who signs up in the Developer Portal.
DEVELOPER_USERNAME=client.developer@example.com
DEVELOPER_PASSWORD=Developer@123

CLIENT_APP_NAME=NonRegOBClientApp
CALLBACK_URL=https://www.google.com

# Port of the local server that serves the client application's JWKS.
JWKS_PORT=8000

# The customer, who signs in to approve consents.
CUSTOMER_USERNAME=customer@example.com
CUSTOMER_PASSWORD=Customer@123
